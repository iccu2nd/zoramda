# ===== Required =====
MONGODB_URI=mongodb://localhost:27017/zorabot
MONGODB_DB_NAME=zorabot

# Signs session tokens (JWT) issued at login/register — keep this secret
JWT_SECRET=change-this-to-another-long-random-secret

# ===== Optional =====
# ADMIN_API_KEY — operator/tooling shortcut only. NOT required for normal
# accounts: users register + log in with their own username/password and
# never need this key.
# ADMIN_API_KEY=change-this-admin-key
# API_SECRET=change-this-to-a-long-random-secret-key

# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
