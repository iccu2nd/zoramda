NODE_ENV=development
PORT=3000
HOST=0.0.0.0

MONGODB_URI=mongodb://localhost:27017/botenv
MONGODB_DB_NAME=botenv

API_SECRET=change-me
JWT_SECRET=change-me
ADMIN_API_KEY=change-me

LOG_LEVEL=info
LATENCY_LOG_THRESHOLD_MS=500

MAX_SESSIONS_PER_USER=5
SESSION_RECONNECT_MAX_RETRIES=10
SESSION_RECONNECT_BASE_DELAY_MS=2000
SESSION_RECONNECT_MAX_DELAY_MS=60000

# --- Email verification (Resend) ---
# Get an API key at https://resend.com
RESEND_API_KEY=
# Must be a verified domain in Resend, or onboarding@resend.dev for testing
# (optional — defaults to noreply@botenv.my.id if left empty)
RESEND_FROM_EMAIL=
# Public URL of this app, used to build the verification link.
# OPTIONAL — leave empty to auto-detect from the incoming request's
# domain/protocol. Only set this if you need to force a specific domain.
APP_URL=
EMAIL_VERIFY_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
