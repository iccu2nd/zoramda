# ===== Required =====
MONGODB_URI=mongodb://localhost:27017/zorabot
MONGODB_DB_NAME=zorabot

# API auth
ADMIN_API_KEY=change-this-admin-key
API_SECRET=change-this-to-a-long-random-secret-key
JWT_SECRET=change-this-to-another-long-random-secret

# ===== Optional (defaults fine for most hosts) =====
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
